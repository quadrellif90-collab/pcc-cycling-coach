# PCC Pro — configurazione BIA cloud vision (opzionale)
#
# Se BIA_VISION_API_KEY e' presente, il parser BIA dei PDF scansionati
# usa un modello vision z.ai e ritorna JSON strutturato (qualita' identica
# all'OCR z.ai: virgole decimali preservate, nessun errore di colonna).
# Se ASSENTE, il parser cade su Tesseract (OCR locale, ~85% su AKERN).
#
# COPIA questo file in .env e inserisci la tua chiave reale.

# Chiave API z.ai (https://api.z.ai) — richiesta per attivare il layer cloud
BIA_VISION_API_KEY=***

# Endpoint OpenAI-compatible z.ai (NON /v1, ma /api/paas/v4)
BIA_VISION_BASE_URL=https://api.z.ai/api/paas/v4

# Modello vision (flash = veloce; cambia se z.ai aggiorna i nomi)
BIA_VISION_MODEL=glm-4.7-flash
